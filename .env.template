# InvenTree environment variables for the Apache reverse-proxy docker deployment.
# For the full list of options, see: https://docs.inventree.org/en/stable/start/config/
#
# This file is a documented reference. `install.sh` generates a real `.env`
# from your answers — you normally do not need to edit this by hand. If you
# prefer a manual install, copy this to `.env` and replace every __TOKEN__.

# Docker-compose project name
COMPOSE_PROJECT_NAME=inventree

# InvenTree version tag (e.g. 'stable' / 'latest' / 'x.x.x').
# Pin to an explicit release for predictable updates, e.g. INVENTREE_TAG=0.17.0
INVENTREE_TAG=stable

# Public site URL. MUST be the https URL served by Apache, so InvenTree builds
# correct links and trusts the origin for CSRF.
INVENTREE_SITE_URL="https://__DOMAIN__"
INVENTREE_WEB_PORT=8000

# Proxy forwarding — required because InvenTree sits behind Apache -> Caddy.
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# Location of the external data volume (database, media, static, secret key...).
INVENTREE_EXT_VOLUME=./inventree-data

# Production logging
INVENTREE_LOG_LEVEL=WARNING

# Enable custom plugins?
INVENTREE_PLUGINS_ENABLED=True

# Run database migrations automatically on container start?
# (update.sh still runs `invoke update` explicitly to also collect static files.)
INVENTREE_AUTO_UPDATE=True

# Superuser account — auto-created on first start.
INVENTREE_ADMIN_USER=__ADMIN_USER__
INVENTREE_ADMIN_PASSWORD=__ADMIN_PASSWORD__
INVENTREE_ADMIN_EMAIL=__ADMIN_EMAIL__

# Database configuration — do not change unless you know the stack.
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432

# Database credentials (PostgreSQL, NOT the InvenTree login).
INVENTREE_DB_USER=pguser
INVENTREE_DB_PASSWORD=__DB_PASSWORD__

# Redis cache
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

# gunicorn
INVENTREE_GUNICORN_TIMEOUT=90
